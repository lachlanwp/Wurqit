{
  "name": "wurqit",
  "version": "1.0.7",
  "main": "src/main.js",
  "homepage": "https://www.wurqit.com",
  "email": "lwpearce@gmail.com",
  "author": {
    "email": "lwpearce@gmail.com",
    "name": "Lachlan Pearce",
    "url": "https://www.wurqit.com"
  },
  "scripts": {
    "build:ts": "tsc",
    "build:ts:watch": "tsc --watch",
    "build:renderer": "vite build",
    "build:app": "yarn build:ts && yarn build:renderer",
    "dev": "yarn build:ts && node scripts/dev.mjs",
    "start": "yarn build:app && electron .",
    "build": "yarn build:app && dotenv electron-builder",
    "typecheck": "tsc --noEmit -p tsconfig.renderer.json",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/preset-env": "^7.28.0",
    "@electron/notarize": "^2.2.0",
    "@types/jest": "^29",
    "@types/node": "^18.19.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "dotenv-cli": "^4.0.0",
    "electron": "^28.2.0",
    "electron-builder": "^26.0.12",
    "jest": "^29",
    "ts-jest": "^29",
    "typescript": "^5.9",
    "vite": "^8.1.5"
  },
  "dependencies": {
    "@electron/remote": "2.1.3",
    "electron-is-dev": "^1.2.0",
    "ffmpeg-static": "^5.1.0",
    "mobx": "^6.16.1",
    "mobx-react-lite": "^4.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.1"
  },
  "build": {
    "afterSign": "notarize.js",
    "appId": "com.lachlanpearce.wurqit",
    "productName": "Wurqit",
    "files": [
      "**/*",
      "!media/**/*",
      "!renderer/**/*",
      "!scripts/**/*",
      "!tests/**/*",
      "!docs/**/*",
      "!src/**/*.ts",
      "!src/**/*.map",
      "!**/*.md"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "extraResources": [
      {
        "from": "media",
        "to": "app.asar.unpacked/media",
        "filter": [
          "**/*"
        ]
      }
    ],
    "directories": {
      "buildResources": "media"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "media/icon/windows/app.ico"
    },
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "media/icon/apple/app.icns",
      "entitlements": "info.plist",
      "entitlementsInherit": "info.inherit.plist",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "target": {
        "target": "dmg",
        "arch": [
          "universal"
        ]
      }
    },
    "dmg": {
      "sign": false
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "media/icon/windows.png"
    }
  }
}
